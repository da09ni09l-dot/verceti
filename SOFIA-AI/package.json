{
  "name": "sofia-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SOFIA AI desktop voice assistant for Windows",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.sofiaai.desktop",
    "productName": "SOFIA AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "voice/dist/sofia-listener",
        "to": "sofia-listener",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
