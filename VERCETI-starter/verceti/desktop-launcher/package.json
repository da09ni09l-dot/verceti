{
  "name": "verceti-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "VERCETI desktop launcher for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:win:dir": "electron-builder --win dir --x64 --publish never",
    "dist:store": "electron-builder --win appx --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.verceti.desktop",
    "productName": "VERCETI",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["electron/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "VERCETI-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "VERCETTI1.verceti-media",
      "publisher": "CN=B13530CC-B95E-42C7-8E0F-920105E6C539",
      "publisherDisplayName": "VERCETTI1",
      "displayName": "VERCETI",
      "applicationId": "VERCETIMedia",
      "languages": ["uk-UA", "en-US", "ru-RU"],
      "capabilities": ["runFullTrust", "internetClient", "microphone"],
      "backgroundColor": "#171717"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VERCETI",
      "deleteAppDataOnUninstall": false
    }
  }
}