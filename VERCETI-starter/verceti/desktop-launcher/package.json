{
  "name": "vercetti-launcher",
  "version": "2026.1.0",
  "private": true,
  "description": "VERCETTI desktop launcher for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vercetti.launcher",
    "productName": "VERCETTI",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["electron/**/*", "package.json"],
    "win": {
      "target": ["nsis"],
      "artifactName": "VERCETTI-LAUNCHER-2026-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VERCETTI"
    }
  }
}
