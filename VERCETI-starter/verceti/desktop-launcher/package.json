{
  "name": "vercetti-launcher",
  "version": "2026.2.0",
  "private": true,
  "description": "VERCETI desktop launcher for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vercetti.launcher",
    "productName": "VERCETI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VERCETI-LAUNCHER-2026-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VERCETI"
    }
  }
}
